{
  "name": "rbi-prep-os-2027",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "RBI Prep OS 2027 — Personal Study Command Center",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron dist-gh-pages server.js release",
    "lint": "tsc --noEmit",
    "test": "tsx local_first_v5.test.ts && tsx electron_security.test.ts && tsx v1_1_optimization.test.ts && tsx v1_2_persistence.test.ts",
    "build:github-pages": "vite build --config vite.github-pages.config.ts",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && tsc -p electron/tsconfig.json && electron-builder --config electron-builder.config.json",
    "electron:preview": "tsc -p electron/tsconfig.json && electron .",
    "electron:pack": "electron-builder --config electron-builder.config.json --dir"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0",
    "idb": "^8.0.4",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.0",
    "electron": "^33.3.0",
    "electron-builder": "^25.1.8",
    "eslint": "^10.14.0",
    "fake-indexeddb": "^6.2.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0",
    "wait-on": "^8.0.2"
  }
}
